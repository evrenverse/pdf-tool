{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evrenverse/pdf-tool/blob/main/src/pdf_tool/schemas/batch.schema.json",
  "title": "pdf-tool batch input",
  "type": "object",
  "properties": {
    "fill": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "write": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["page", "x", "y", "text"],
        "properties": {
          "page": {"type": "integer", "minimum": 0},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "text": {"type": "string"},
          "font": {"type": "string"},
          "font_size": {"type": "number", "exclusiveMinimum": 0},
          "image_width": {"type": "number", "exclusiveMinimum": 0},
          "image_height": {"type": "number", "exclusiveMinimum": 0},
          "pdf_width": {"type": "number", "exclusiveMinimum": 0},
          "pdf_height": {"type": "number", "exclusiveMinimum": 0}
        },
        "allOf": [
          {
            "if": {"required": ["image_width"]},
            "then": {"required": ["image_height"]}
          },
          {
            "if": {"required": ["image_height"]},
            "then": {"required": ["image_width"]}
          },
          {
            "if": {"required": ["pdf_width"]},
            "then": {"required": ["pdf_height"]}
          },
          {
            "if": {"required": ["pdf_height"]},
            "then": {"required": ["pdf_width"]}
          },
          {
            "not": {"required": ["image_width", "pdf_width"]}
          }
        ],
        "additionalProperties": false
      }
    },
    "sign": {
      "type": "object",
      "required": ["image", "page", "position"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 0},
        "position": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "certificate": {"type": "string", "minLength": 1},
        "no_passphrase": {"type": "boolean"}
      },
      "not": {"required": ["passphrase"]},
      "additionalProperties": false
    }
  },
  "anyOf": [
    {"required": ["fill"]},
    {"required": ["write"]},
    {"required": ["sign"]}
  ],
  "additionalProperties": false
}
